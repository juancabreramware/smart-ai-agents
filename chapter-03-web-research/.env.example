# OpenAI: choose a CURRENT model in your own account. The repository deliberately
# does not freeze a model name into a book that should remain useful for years.
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_RESPONSES_ENDPOINT=https://api.openai.com/v1/responses

# Enter current prices for the model you selected before publishing benchmark data.
OPENAI_INPUT_USD_PER_MILLION=0
OPENAI_CACHED_INPUT_USD_PER_MILLION=0
OPENAI_OUTPUT_USD_PER_MILLION=0

# Optional: only needed for live source discovery when pricing_url is omitted.
SERPER_API_KEY=
SERPER_ENDPOINT=https://google.serper.dev/search
# Set this to YOUR current effective cost per 1,000 searches before a live benchmark.
# Leave 0 for the controlled Chapter 3 experiment, which does not call Serper.
SERPER_USD_PER_1000_SEARCHES=0

HTTP_USER_AGENT=SmartAIAgents-Book-Experiment/1.0
HTTP_TIMEOUT_SECONDS=20
PLAYWRIGHT_TIMEOUT_MS=20000
CAPABILITY_DIR=capabilities/registry
LEDGER_DIR=benchmark/results
BENCHMARK_SITE_HOST=127.0.0.1
BENCHMARK_SITE_PORT=8765
