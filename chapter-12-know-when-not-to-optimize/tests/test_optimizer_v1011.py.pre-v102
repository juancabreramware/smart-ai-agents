from src.models import OptimizationCase
from src.optimizer import decide, _future_reuse_estimate

def test_sparse_observations_remain_defer_not_terminal_reason_only():
    c=OptimizationCase("stable_rare",observed_count=20,eligible_reuse_count=20,reasoning_cost_estimate_micro=1200)
    result=decide(c,"stable_rare",180)
    assert result.decision=="DEFER"
    assert result.decision_reason=="BREAK_EVEN_NOT_YET_CLEARED"

def test_emerging_pattern_remains_reevaluable_when_not_yet_break_even():
    c=OptimizationCase("emerging_pattern",observed_count=16,eligible_reuse_count=16,reasoning_cost_estimate_micro=1200)
    result=decide(c,"emerging_pattern",120)
    assert result.decision=="DEFER"

def test_emerging_pattern_promotes_only_when_observed_density_really_clears_break_even():
    # Same family economics, but recurrence is now dense enough in observed
    # history to justify promotion without any future leakage.
    c=OptimizationCase("emerging_pattern",observed_count=16,eligible_reuse_count=16,reasoning_cost_estimate_micro=1200)
    result=decide(c,"emerging_pattern",40)
    assert result.decision=="PROMOTE"
    assert result.expected_reuse_value_micro > result.expected_optimization_cost_micro

def test_ambiguous_remains_reason_only():
    c=OptimizationCase("ambiguous_judgment",observed_count=20,eligible_reuse_count=20,reasoning_cost_estimate_micro=1200)
    assert decide(c,"ambiguous_judgment",100).decision=="REASON_ONLY"
